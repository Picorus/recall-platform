# P2.3.2: the broker for the screen line (EMQX 5). Rendered by renderEmqxConfig() in
# services/gateway/src/emqx-config.ts; the values in double braces come from the environment.
#  - Screens connect only over TLS (port {{SSL_PORT}}) with a certificate from RECALL's screen
#    certificate authority ({{CERT_DIR}}/screens-ca.pem); the broker passes the certificate's MD5
#    fingerprint and name to the gateway, which checks it is one we issued and still valid.
#  - The gateway connects on the internal port ({{TCP_BIND}}), never reachable from outside.
#  - Every connection and every topic is decided by the gateway (HTTP hooks); no match = refused.
node {
  name = "emqx@127.0.0.1"
  cookie = "{{NODE_COOKIE}}"
  data_dir = "data"
}
cluster { name = recall, discovery_strategy = manual }
dashboard { listeners.http { bind = 0 } }

listeners.tcp.default { bind = "{{TCP_BIND}}" }
listeners.ws.default { enable = false }
listeners.wss.default { enable = false }
listeners.ssl.default {
  bind = "0.0.0.0:{{SSL_PORT}}"
  zone = screens
  ssl_options {
    cacertfile = "{{CERT_DIR}}/screens-ca.pem"
    certfile = "{{CERT_DIR}}/server.pem"
    keyfile = "{{CERT_DIR}}/server.key"
    verify = verify_peer
    fail_if_no_peer_cert = true
    versions = ["tlsv1.3", "tlsv1.2"]
  }
}
# On the TLS port the user name is the certificate's fingerprint, so a screen cannot choose it.
zones.screens { mqtt { peer_cert_as_username = md5, peer_cert_as_clientid = disabled } }
mqtt { max_packet_size = 300KB }

authentication = [{
  mechanism = password_based
  backend = http
  method = post
  url = "{{HOOK_URL}}/emqx/authn"
  headers { "content-type" = "application/json", "authorization" = "Bearer {{HOOK_TOKEN}}" }
  body {
    clientid = "${clientid}"
    username = "${username}"
    password = "${password}"
    cert_common_name = "${cert_common_name}"
  }
}]

authorization {
  no_match = deny
  deny_action = disconnect
  cache { enable = false }
  sources = [{
    type = http
    method = post
    url = "{{HOOK_URL}}/emqx/authz"
    headers { "content-type" = "application/json", "authorization" = "Bearer {{HOOK_TOKEN}}" }
    body { clientid = "${clientid}", username = "${username}", topic = "${topic}", action = "${action}" }
  }]
}
