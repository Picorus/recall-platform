{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "@recall/repo-checks#test": {
      "cache": false
    },
    "@recall/db#test": {
      "dependsOn": ["^typecheck"],
      "cache": false
    }
  }
}
