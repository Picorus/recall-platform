    "maplibre-gl": "6.13.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@recall/domain": "workspace:*",
    "playwright": "1.56.1",
    "@recall/api": "workspace:*",
    "@recall/db": "workspace:*",
    "fast-check": "4.10.2"
