{
  "name": "@recall/brand",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Brand portal (Next.js): brands and agencies book, pay, upload ads and get reports (P5).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/e2e/tsconfig.json",
    "test": "vitest run --passWithNoTests test/unit",
    "test:e2e": "vitest run test/e2e"
  },
  "dependencies": {
    "@recall/design": "workspace:*",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@recall/adapters": "workspace:*",
    "@recall/api": "workspace:*",
    "@recall/db": "workspace:*",
    "@recall/domain": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.56.1"
  }
}
