# Copy to .env and fill in. Never commit .env.
# Real keys stay empty here (hard rule 6). The other values only point at the laptop containers.

NODE_ENV=development

# Laptop containers (infra/docker-compose.yml). Throwaway local passwords, not real secrets.
LOCAL_POSTGRES_PASSWORD=recall

# Connections
DATABASE_URL=postgres://recall:recall@localhost:5432/recall
REDIS_URL=redis://localhost:6379
MQTT_URL=mqtt://localhost:1883
# Screen gateway (P2.3.2): the broker's internal port, where the broker reaches the gateway's
# hooks (empty: 127.0.0.1 and 8090), and two secrets (set them in the secret store; empty here).
GATEWAY_MQTT_URL=mqtt://localhost:1883
GATEWAY_HOOK_HOST=
GATEWAY_HOOK_PORT=
GATEWAY_HOOK_TOKEN=
GATEWAY_MQTT_PASSWORD=
# API (P3.1): the key that keeps staff two-step secrets encrypted (32 bytes as 64 hex characters;
# secret store; empty here: a laptop uses a fixed throwaway key), the admin site's address(es) that
# may send changes, the API's own address (keep it private: only the admin site calls it), and how
# many of our own proxies that add to X-Forwarded-For stand in front (load balancer, CDN; not the
# admin site; must be set in production). API_INSECURE_COOKIES=yes only on a laptop over http.
# The admin site finds the API at API_URL.
API_URL=http://127.0.0.1:8080
# Admin fleet map (P3.3): an open base map style (https, no key), e.g. an OpenStreetMap vector
# style, and the other https origins its tiles, fonts and icons come from (comma-separated; the
# style's own origin is always allowed). Empty or not https: a plain map with our areas and bikes
# only (works on a laptop with no network).
ADMIN_MAP_STYLE_URL=
ADMIN_MAP_ORIGINS=
STAFF_SECRET_KEY=
ADMIN_ORIGINS=http://localhost:3001
API_HOST=
API_PORT=
API_PROXY_HOPS=
API_INSECURE_COOKIES=
# Brand payments (P3.8.2): empty on a laptop = the fake provider (no money). The real provider and
# its webhook secret come in P6 (secret store; empty here).
# Ad files (P3.9.1): on a laptop a fake store; where its signed links point (the admin site's
# /api/files path). The real store comes in P6.
FILES_PUBLIC_URL=
PAYMENTS_PROVIDER=
PAYMENTS_WEBHOOK_SECRET=
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=recall-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Outside services (hard rule 4). Each runs its fake until P6 plugs in the real one.
ADAPTER_MAPS=fake
ADAPTER_WHATSAPP=fake
ADAPTER_SMS=fake
ADAPTER_EMAIL=fake
ADAPTER_PAYMENTS=fake
ADAPTER_PAYOUTS=fake
ADAPTER_KYC=fake
ADAPTER_GST=fake
ADAPTER_ESIGN=fake
