# Copy to .env and fill in. Never commit .env.
# Real keys stay empty here (hard rule 6). The other values only point at the laptop containers.

NODE_ENV=development

# Laptop containers (infra/docker-compose.yml). Throwaway local passwords, not real secrets.
LOCAL_POSTGRES_PASSWORD=recall

# Connections
DATABASE_URL=postgres://recall:recall@localhost:5432/recall
REDIS_URL=redis://localhost:6379
MQTT_URL=mqtt://localhost:1883
# Screen gateway (P2.3.2): the broker's internal port, where the broker reaches the gateway's
# hooks (empty: 127.0.0.1 and 8090), and two secrets (set them in the secret store; empty here).
GATEWAY_MQTT_URL=mqtt://localhost:1883
GATEWAY_HOOK_HOST=
GATEWAY_HOOK_PORT=
GATEWAY_HOOK_TOKEN=
GATEWAY_MQTT_PASSWORD=
# API (P3.1): the key that keeps staff two-step secrets encrypted (32 bytes as 64 hex characters;
# secret store; empty here: a laptop uses a fixed throwaway key), the admin site's address(es) that
# may send changes, the API's own address (keep it private: only the admin site calls it), and how
# many of our own proxies that add to X-Forwarded-For stand in front (load balancer, CDN; not the
# admin site; must be set in production). API_INSECURE_COOKIES=yes only on a laptop over http.
# The admin site finds the API at API_URL.
API_URL=http://127.0.0.1:8080
# Admin fleet map (P3.3): an open base map style (https, no key), e.g. an OpenStreetMap vector
# style, and the other https origins its tiles, fonts and icons come from (comma-separated; the
# style's own origin is always allowed). Empty or not https: a plain map with our areas and bikes
# only (works on a laptop with no network).
ADMIN_MAP_STYLE_URL=
ADMIN_MAP_ORIGINS=
STAFF_SECRET_KEY=
ADMIN_ORIGINS=http://localhost:3001
API_HOST=
API_PORT=
API_PROXY_HOPS=
API_INSECURE_COOKIES=
# The rider app's web build (P4.1, for tests and screenshots): its origins, comma-separated. Empty on
# a laptop = Expo's web server (http://localhost:8081); the phone app needs none.
RIDER_APP_ORIGINS=
# The brand portal (P5.1): its origins, comma-separated. Empty on a laptop = http://localhost:3000;
# production must name them.
BRAND_ORIGINS=
# Brand payments (P3.8.2): empty on a laptop = the fake provider (no money). The real provider and
# its webhook secret come in P6 (secret store; empty here).
# Ad files (P3.9.1): on a laptop a fake store; where its signed links point (the admin site's
# /api/files path). The real store comes in P6.
FILES_PUBLIC_URL=
# P2.4.2: the key the API and the screen gateway both sign download links with (secret store; empty
# here). Empty: the gateway sends no file lists (and the screens need HTTPS links, so FILES_PUBLIC_URL
# must be https:// for it to send any).
FILES_LINK_SECRET=
PAYMENTS_PROVIDER=
PAYMENTS_WEBHOOK_SECRET=
# "on": the API makes due make-up and refund decisions every minute (off until the scheduler
# puts make-ups in the screens' plans).
SETTLE_MAKE_UPS=
# Rider checks (KYC, e-sign, ₹1 bank check): "fake" on a laptop only; empty in production until P4.
RIDER_CHECKS_PROVIDER=
# Paying riders (P3.12): "fake" on a laptop only; empty in production until P6 (runs are prepared
# and approved, not sent). "off" in PAYOUT_PREPARE stops the Monday run being prepared by itself.
PAYOUTS_PROVIDER=
# Final reports (P3.14.1): maps and WhatsApp/email "fake" on a laptop only; empty in production until
# P6 (no reports built or sent). Where brands open their report.
REPORTS_PROVIDER=
BRAND_PORTAL_URL=
# Messages people send us (P3.15): "fake" on a laptop only; empty in production until P6.
SUPPORT_INBOUND_PROVIDER=
# Phone notifications to riders (P4.10): "fake" on a laptop only; empty in production until P6.
PUSH_PROVIDER=
PAYOUT_PREPARE=
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=recall-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Outside services (hard rule 4). Each runs its fake until P6 plugs in the real one.
ADAPTER_MAPS=fake
ADAPTER_WHATSAPP=fake
ADAPTER_SMS=fake
ADAPTER_EMAIL=fake
ADAPTER_PAYMENTS=fake
ADAPTER_PAYOUTS=fake
ADAPTER_KYC=fake
ADAPTER_GST=fake
ADAPTER_ESIGN=fake
# GST number lookup for the brand portal (P5.2): empty on a laptop = the fake. The real provider (a
# GST Suvidha Provider) comes in P6; until then production has none and businesses type their details.
GST_PROVIDER=
