{
  "name": "@recall/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Device gateway: holds the MQTT line to every screen.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests test/unit",
    "test:db": "vitest run test/db",
    "test:emqx": "vitest run test/emqx",
    "start": "tsx src/run.ts",
    "load": "tsx src/load.ts"
  },
  "dependencies": {
    "@recall/adapters": "workspace:*",
    "@recall/db": "workspace:*",
    "@recall/domain": "workspace:*",
    "mqtt": "5.16.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@peculiar/x509": "2.1.0",
    "@types/pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "tsx": "4.23.15"
  }
}
