{
  "name": "@recall/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Every app's front door: sign-in, bookings, areas, riders, payments, reports.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests test/unit",
    "test:db": "vitest run test/db",
    "start": "tsx src/run.ts",
    "first-admin": "tsx src/first-admin.ts",
    "reset-staff": "tsx src/reset-staff.ts"
  },
  "dependencies": {
    "@expo-google-fonts/anek-latin": "0.4.2",
    "@expo-google-fonts/anek-telugu": "0.4.1",
    "@recall/adapters": "workspace:*",
    "@recall/db": "workspace:*",
    "@recall/domain": "workspace:*",
    "@recall/workers": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "fast-check": "4.10.2",
    "tsx": "4.23.15"
  }
}
